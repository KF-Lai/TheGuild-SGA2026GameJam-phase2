<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- 主場景視窗根節點。底層為公會場景 nav 入口列（6 個建築物 icon button）。 -->
    <!-- USS 樣式：Assets/UI/USS/MainSceneCommon.uss -->
    <ui:VisualElement name="main-scene-root" class="main-scene-root" picking-mode="Ignore" style="flex-grow: 1; position: absolute; left: 0; right: 0; top: 0; bottom: 0;">

        <!-- 6 個建築物 nav button（GDD §3.2 / FSD §5.4.10 場景物件互動點） -->
        <!-- 排版：水平等寬鋪滿，每個 button click → PanelManager.OpenPanel -->
        <ui:VisualElement name="nav-row" class="nav-row" picking-mode="Ignore">
            <ui:Button name="nav-commission-board" class="nav-icon nav-commission-board" tooltip="委託板" />
            <ui:Button name="nav-guild-hall" class="nav-icon nav-guild-hall" tooltip="冒險者名冊" />
            <ui:Button name="nav-construction" class="nav-icon nav-construction" tooltip="公會建設" />
            <ui:Button name="nav-safe" class="nav-icon nav-safe" tooltip="公會總覽" />
            <ui:Button name="nav-staff-lounge" class="nav-icon nav-staff-lounge" tooltip="職員名冊" />
            <ui:Button name="nav-settings-desk" class="nav-icon nav-settings-desk" tooltip="設定" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
