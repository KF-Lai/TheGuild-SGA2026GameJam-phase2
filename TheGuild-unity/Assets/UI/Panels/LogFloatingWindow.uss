.log-floating-window {
    position: absolute;
    right: 32px;
    bottom: 32px;
    width: 320px;
    max-height: 420px;
    padding: 8px;
    background-color: rgba(18, 18, 18, 0.92);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.log-floating-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.log-floating-title {
    font-size: 14px;
    color: rgb(235, 235, 235);
}

.log-floating-close {
    width: 24px;
    height: 24px;
}

.log-floating-scroll {
    max-height: 360px;
}

.log-floating-list {
    flex-direction: column;
}
