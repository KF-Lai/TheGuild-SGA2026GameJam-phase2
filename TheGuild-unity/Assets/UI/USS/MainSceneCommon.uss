/* P-02 Main UI Common USS — art 接入中（A-01 公會橫幅 2026-05-03） */

/* A-01：公會橫幅景觀 1920×312，置於場景頂部全寬 */
.bg-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 312px;
    background-image: url("project://database/Assets/Art/UI/Scene/A-01_default.png");
    -unity-background-scale-mode: scale-and-crop;
}

.p02-panel {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 10%;
    bottom: 25%;
    background-color: rgba(20, 20, 30, 0.85);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(180, 150, 90, 0.7);
    padding: 16px;
}

.p02-modal-mask {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.40);
}

.hud-element {
    color: rgb(255, 235, 200);
    -unity-font-style: bold;
}

.hud-gold-negative {
    color: rgb(220, 80, 80);
}
