/* P-02 Main UI Common USS */
/* 7 個場景元素已移至 SpriteRenderer GameObject；本 USS 僅管 floor / HUD / panel 樣式 */

.main-scene-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* ──────────── 木地板（A-14，貼底全寬） ──────────── */
.floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30px;
    background-image: url("project://database/Assets/Art/UI/Scene/A-14_default.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ──────────── HUD 元素 ──────────── */

.hud-element {
    color: rgb(255, 235, 200);
    -unity-font-style: bold;
}

.hud-gold-negative {
    color: rgb(220, 80, 80);
}

/* ──────────── panel modal class ──────────── */

.p02-panel {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 10%;
    bottom: 25%;
    background-color: rgba(20, 20, 30, 0.85);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(180, 150, 90, 0.7);
    padding: 16px;
}

.p02-modal-mask {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.40);
}
